{
  "env": {
    "browser": true,
    "node": true,
    "commonjs": true,
    "es2022": true,
    "jest": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2022
  },
  "overrides": [
    {
      "files": ["frontend/**/*.js", "vite.config.js", "scripts/build-all.js"],
      "parserOptions": {
        "sourceType": "module"
      }
    }
  ],
  "rules": {
    "no-unused-vars": ["error", { "args": "none" }]
  }
}
